{
  "name": "exasol-vscode",
  "displayName": "Exasol",
  "icon": "resources/exasol-icon.png",
  "description": "Feature-rich Exasol database extension for Visual Studio Code with IntelliSense, object browser, query execution, and more",
  "version": "1.4.0",
  "publisher": "exasol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/exasol-labs/exasol-vscode"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "exasol",
    "sql",
    "database",
    "query"
  ],
  "activationEvents": [
    "onView:exasol.connections",
    "onView:exasol.objects",
    "onView:exasol.queryHistory"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "exasol-sql",
        "aliases": [
          "Exasol SQL",
          "exasol-sql",
          "Exasol"
        ],
        "extensions": [
          ".exasql",
          ".exs",
          ".sql"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/exasol-icon.svg",
          "dark": "./resources/exasol-icon.svg"
        }
      }
    ],
    "fileExtensions": {
      "sql": "exasol-sql"
    },
    "grammars": [
      {
        "language": "exasol-sql",
        "scopeName": "source.exasol.sql",
        "path": "./syntaxes/exasol-sql.tmLanguage.json"
      }
    ],
    "notebooks": [
      {
        "type": "exasol-sql-notebook",
        "displayName": "Exasol SQL Notebook",
        "selector": [
          { "filenamePattern": "*.exabook" }
        ]
      }
    ],
    "commands": [
      {
        "command": "exasol.addConnection",
        "title": "Exasol: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "exasol.refreshConnections",
        "title": "Exasol: Refresh Connections",
        "icon": "$(refresh)"
      },
      {
        "command": "exasol.executeQuery",
        "title": "Exasol: Execute Query",
        "icon": "$(play)"
      },
      {
        "command": "exasol.executeSelectedQuery",
        "title": "Exasol: Execute Selected Query"
      },
      {
        "command": "exasol.executeScript",
        "title": "Exasol: Execute Script",
        "icon": "$(run-all)"
      },
      {
        "command": "exasol.showQueryHistory",
        "title": "Exasol: Show Query History",
        "icon": "$(history)"
      },
      {
        "command": "exasol.exportResults",
        "title": "Exasol: Export Results to CSV"
      },
      {
        "command": "exasol.previewTable",
        "title": "Preview Table (100 rows)"
      },
      {
        "command": "exasol.showTableDDL",
        "title": "Show Table DDL"
      },
      {
        "command": "exasol.showViewDDL",
        "title": "Show View DDL"
      },
      {
        "command": "exasol.generateSelect",
        "title": "Generate SELECT Statement"
      },
      {
        "command": "exasol.describeTable",
        "title": "Describe Table"
      },
      {
        "command": "exasol.setSchema",
        "title": "Set as Active Schema"
      },
      {
        "command": "exasol.clearCache",
        "title": "Exasol: Clear Autocomplete Cache"
      },
      {
        "command": "exasol.editConnection",
        "title": "Edit Connection"
      },
      {
        "command": "exasol.deleteConnection",
        "title": "Delete Connection"
      },
      {
        "command": "exasol.renameConnection",
        "title": "Rename Connection"
      },
      {
        "command": "exasol.setActiveConnection",
        "title": "Exasol: Set Active Connection"
      },
      {
        "command": "exasol.disconnectConnection",
        "title": "Exasol: Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "exasol.openObject",
        "title": "Open Object"
      },
      {
        "command": "exasol.copyQualifiedName",
        "title": "Copy Name",
        "icon": "$(copy)"
      },
      {
        "command": "exasol.formatQuery",
        "title": "Exasol: Format Query"
      },
      {
        "command": "exasol.toggleSeparateResultTabs",
        "title": "Exasol: Toggle Separate Result Tabs"
      },
      {
        "command": "exasol.findObject",
        "title": "Exasol: Find Database Object",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "exasol-explorer",
          "title": "Exasol",
          "icon": "resources/exasol-activity-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "exasol-panel",
          "title": "Exasol",
          "icon": "resources/exasol-activity-icon.svg"
        }
      ]
    },
    "views": {
      "exasol-explorer": [
        {
          "id": "exasol.connections",
          "name": "Connections",
          "visibility": "visible",
          "initialSize": 10
        },
        {
          "id": "exasol.objects",
          "name": "Database Objects",
          "visibility": "visible",
          "initialSize": 60
        },
        {
          "id": "exasol.queryHistory",
          "name": "Query History",
          "visibility": "visible",
          "initialSize": 3
        }
      ],
      "exasol-panel": [
        {
          "id": "exasol.results",
          "name": "Query Results",
          "type": "webview"
        },
        {
          "id": "exasol.queryStats",
          "name": "Query Info",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "exasol.addConnection",
          "when": "view == exasol.connections",
          "group": "navigation"
        },
        {
          "command": "exasol.refreshConnections",
          "when": "view == exasol.connections",
          "group": "navigation"
        },
        {
          "command": "exasol.refreshConnections",
          "when": "view == exasol.objects",
          "group": "navigation"
        },
        {
          "command": "exasol.findObject",
          "when": "view == exasol.objects",
          "group": "navigation"
        },
        {
          "command": "exasol.showQueryHistory",
          "when": "view == exasol.queryHistory",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "exasol.showTableDDL",
          "when": "view == exasol.objects && viewItem == table",
          "group": "exasol@1"
        },
        {
          "command": "exasol.previewTable",
          "when": "view == exasol.objects && viewItem == table",
          "group": "exasol@2"
        },
        {
          "command": "exasol.describeTable",
          "when": "view == exasol.objects && viewItem == table",
          "group": "exasol@3"
        },
        {
          "command": "exasol.generateSelect",
          "when": "view == exasol.objects && viewItem == table",
          "group": "exasol@4"
        },
        {
          "command": "exasol.showViewDDL",
          "when": "view == exasol.objects && viewItem == view",
          "group": "exasol@1"
        },
        {
          "command": "exasol.previewTable",
          "when": "view == exasol.objects && viewItem == view",
          "group": "exasol@2"
        },
        {
          "command": "exasol.generateSelect",
          "when": "view == exasol.objects && viewItem == view",
          "group": "exasol@3"
        },
        {
          "command": "exasol.copyQualifiedName",
          "when": "view == exasol.objects && (viewItem == table || viewItem == view || viewItem == schema)",
          "group": "inline@1"
        },
        {
          "command": "exasol.setSchema",
          "when": "view == exasol.objects && viewItem == schema",
          "group": "exasol@1"
        },
        {
          "command": "exasol.setActiveConnection",
          "when": "view == exasol.connections && viewItem == connection",
          "group": "connection@0"
        },
        {
          "command": "exasol.disconnectConnection",
          "when": "view == exasol.connections && viewItem == connection",
          "group": "connection@1"
        },
        {
          "command": "exasol.editConnection",
          "when": "view == exasol.connections && viewItem == connection",
          "group": "connection@2"
        },
        {
          "command": "exasol.deleteConnection",
          "when": "view == exasol.connections && viewItem == connection",
          "group": "connection@3"
        },
        {
          "command": "exasol.renameConnection",
          "when": "view == exasol.connections && viewItem == connection",
          "group": "connection@4"
        }
      ],
      "editor/context": [
        {
          "command": "exasol.executeSelectedQuery",
          "when": "editorLangId == exasol-sql",
          "group": "exasol@1"
        },
        {
          "command": "exasol.executeScript",
          "when": "editorLangId == exasol-sql",
          "group": "exasol@2"
        }
      ],
      "commandPalette": [
        {
          "command": "exasol.executeQuery"
        },
        {
          "command": "exasol.executeSelectedQuery"
        },
        {
          "command": "exasol.executeScript"
        },
        {
          "command": "exasol.clearCache"
        },
        {
          "command": "exasol.previewTable",
          "when": "false"
        },
        {
          "command": "exasol.showTableDDL",
          "when": "false"
        },
        {
          "command": "exasol.showViewDDL",
          "when": "false"
        },
        {
          "command": "exasol.generateSelect",
          "when": "false"
        },
        {
          "command": "exasol.describeTable",
          "when": "false"
        },
        {
          "command": "exasol.setSchema",
          "when": "false"
        },
        {
          "command": "exasol.editConnection",
          "when": "false"
        },
        {
          "command": "exasol.deleteConnection",
          "when": "false"
        },
        {
          "command": "exasol.formatQuery",
          "when": "editorLangId == exasol-sql"
        },
        {
          "command": "exasol.findObject"
        },
        {
          "command": "exasol.disconnectConnection"
        }
      ]
    },
    "configuration": {
      "title": "Exasol",
      "properties": {
        "exasol.maxQueryHistorySize": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of queries to keep in history"
        },
        "exasol.queryTimeout": {
          "type": "number",
          "default": 300,
          "description": "Query execution timeout in seconds"
        },
        "exasol.maxResultRows": {
          "type": "number",
          "default": 10000,
          "description": "Maximum number of rows to fetch from query results"
        },
        "exasol.connectionValidationTimeout": {
          "type": "number",
          "default": 1,
          "description": "Timeout in seconds for validating if a connection is still alive (lower values detect stale connections faster, recommended: 1-2 seconds)"
        },
        "exasol.autoComplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable SQL auto-completion"
        },
        "exasol.showQueryNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show toast notifications after query execution with success/failure status, duration, and row count"
        },
        "exasol.formatter.keywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "upper",
          "description": "Controls the case of SQL keywords when formatting"
        },
        "exasol.formatter.indentStyle": {
          "type": "string",
          "enum": [
            "standard",
            "tabularLeft",
            "tabularRight"
          ],
          "default": "standard",
          "description": "Controls the indentation style for formatted SQL"
        },
        "exasol.formatter.tabWidth": {
          "type": "number",
          "default": 2,
          "description": "Number of spaces per indentation level (when using spaces)"
        },
        "exasol.formatter.useTabs": {
          "type": "boolean",
          "default": false,
          "description": "Use tabs instead of spaces for indentation"
        },
        "exasol.formatter.linesBetweenQueries": {
          "type": "number",
          "default": 2,
          "description": "Number of blank lines between SQL statements"
        },
        "exasol.separateResultTabs": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, multi-statement executions display each result in a separate tab"
        }
      }
    },
    "keybindings": [
      {
        "command": "exasol.executeQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorLangId == exasol-sql"
      },
      {
        "command": "exasol.executeSelectedQuery",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == exasol-sql"
      },
      {
        "command": "exasol.executeScript",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorLangId == exasol-sql"
      },
      {
        "command": "exasol.findObject",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "focusedView == exasol.objects"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "package": "npm run check-types && node esbuild.mjs --production",
    "pretest": "npm run compile && npm run lint",
    "lint": "echo 'Linting skipped'",
    "test": "node ./out/test/runTest.js",
    "test:unit": "mocha --ui tdd --require ts-node/register 'src/test/unit/**/*.test.ts'",
    "test:local": "mocha --ui tdd --require ts-node/register 'src/test/local/*.test.ts'",
    "test:watch": "mocha --ui tdd --require ts-node/register --watch 'src/test/unit/**/*.test.ts'",
    "test:e2e": "node ./out/test/local/e2e/runTest.js"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.1",
    "glob": "^13.0.0",
    "jsdom": "^29.0.0",
    "mocha": "^11.7.1",
    "ovsx": "^0.10.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@exasol/exasol-driver-ts": "^0.3.1",
    "@types/ws": "^8.18.1",
    "sql-formatter": "^15.7.2",
    "ws": "^8.19.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "glob": "$glob"
  }
}
