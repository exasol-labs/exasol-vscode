-- Test file to demonstrate the inline comment semicolon fix

-- Case 1: Semicolon in inline comment should NOT terminate the statement
SELECT * FROM table1 WHERE id = 1 -- This is a test;
AND name = 'test';

-- Case 2: Semicolon with trailing spaces in comment
SELECT * FROM table2 WHERE id = 2 -- Comment;   
AND status = 'active';

-- Case 3: Multiple inline comments with semicolons
SELECT -- comment1;
    column1, -- comment2;
    column2
FROM table3; -- final comment;

-- Case 4: Real semicolon followed by comment (should terminate)
SELECT * FROM table4; -- This is the end

-- Case 5: Complex real-world scenario
CREATE TABLE test_table (
    id INT, -- primary key;
    name VARCHAR(100), -- user name;
    status VARCHAR(20) -- active/inactive;
); -- end of CREATE TABLE;

-- Case 6: Consecutive semicolons in comments
SELECT * FROM table5 WHERE id = 5 -- test;;; more;;;
AND name = 'test';

-- Case 7: Multi-line comment with semicolon (should NOT terminate)
SELECT * FROM table6 /* comment
with semicolon; inside */ WHERE id = 6;

-- Case 8: Inline multi-line comment with semicolon
SELECT * FROM table7 /* comment; */ WHERE status = 'active';

-- Case 9: Multiple multi-line comments with semicolons
SELECT /* first; */
    column1, /* second; more; */
    column2
FROM table8;

-- Case 10: Mixed single-line and multi-line comments
SELECT * FROM table9 /* block comment; */ WHERE id = 9 -- line comment;
AND active = true;
